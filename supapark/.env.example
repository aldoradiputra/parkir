# SupaPark Cloud Configuration
PORT=8080
DATABASE_URL=postgres://supapark:supapark@localhost:5432/supapark?sslmode=disable
JWT_SECRET=change-me-to-a-random-secret
WEBHOOK_SECRET=change-me-to-a-random-secret

# QRIS Provider (stub for development)
QRIS_PROVIDER=stub

# WhatsApp / Telegram (stub for development)
WHATSAPP_API_KEY=
TELEGRAM_BOT_TOKEN=

# SupaPark Edge Configuration
EDGE_CLOUD_URL=http://localhost:8080
EDGE_API_KEY=your-lane-api-key
EDGE_LOCATION_ID=your-location-uuid
EDGE_LANE_ID=your-lane-uuid
EDGE_LANE_MODE=entry
EDGE_HTTP_PORT=8081

# ALPR
EDGE_ALPR_MOCK=true
EDGE_ALPR_SCRIPT=./scripts/alpr.py
EDGE_RTSP_URL=

# Relay
EDGE_RELAY_TYPE=mock
EDGE_GPIO_OPEN_PIN=17
EDGE_GPIO_CLOSE_PIN=27
EDGE_USB_RELAY_PORT=/dev/ttyUSB0

# Local storage
EDGE_DB_PATH=./edge.db
EDGE_DEBUG=false
